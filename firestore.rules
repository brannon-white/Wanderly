rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Clients may create their own user doc but must not pre-set monetization fields.
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['subscription', 'usage']);
      // Clients may update their own profile/preferences but may not touch monetization fields.
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'usage']);
      allow delete: if false;
      match /itineraries/{itineraryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /savedItems/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /destinations/{destination} {
      allow read: if request.auth != null;
    }
    match /featuredTrips/{trip} {
      allow read: if request.auth != null;
    }
    match /prebuiltItineraries/{itinerary} {
      allow read: if request.auth != null;
    }
    match /staticActivities/{activity} {
      allow read: if request.auth != null;
    }
    match /staticFoodPreferences/{preference} {
      allow read: if request.auth != null;
    }
    match /onboardingProgress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /travelPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /foodPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /userInfo/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /articles/{article} {
      allow read: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
