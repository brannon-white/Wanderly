# Backend secrets are stored in Firebase Secret Manager, not in this file:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set GOOGLE_PLACES_API_KEY
#   firebase functions:secrets:set PEXELS_API_KEY
#   firebase functions:secrets:set UNSPLASH_ACCESS_KEY   # optional fallback
#
# This file documents what the functions expect; it holds no values.
