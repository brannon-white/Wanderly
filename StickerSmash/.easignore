# When .easignore exists, EAS Build uses it INSTEAD of .gitignore to decide
# which files to upload. GoogleService-Info.plist is gitignored (kept out of
# the public repo) but is intentionally NOT listed here so EAS builds still
# receive the Firebase config.

# Node modules
node_modules/

# Metro, Expo, and React Native cache
.expo/
.expo-shared/
npm-debug.log
yarn-error.log
yarn-debug.log
*.log

# Build output
android/app/build/
ios/build/
ios/Pods/
*.xcworkspace
*.xcuserstate
*.xcuserdata
*.DS_Store

# Environment files
.env
.env.local
.env.*.local

# Firebase service account keys (never upload these)
serviceAccountKey.json
*firebase-adminsdk*.json
*serviceAccount*.json

# Firebase local deploy cache & logs
.firebase/
firebase-debug.log
*firebase-debug*.log

# VSCode settings
.vscode/

# Mac system files
.DS_Store

# Expo
web-build/
dist/

# Large map data files
*.pbf
*.osm
*.osm.pbf
