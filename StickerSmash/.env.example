# Copy to .env and fill in. .env is gitignored.

# Google OAuth client IDs (public identifiers, safe to share)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# RevenueCat public SDK keys (platform-prefixed: appl_ / goog_)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Optional. Unset disables stock-photo lookup; the UI falls back to
# category-icon placeholders.
EXPO_PUBLIC_UNSPLASH_KEY=
